# Copy this file to .env and replace the secret with a strong random value.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Set to mock for the initial dummy API. Later switch to database.
DATA_MODE=mock
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/business_ops
FRONTEND_ORIGIN=http://localhost:5173
