# Copy to .env and fill in your local SQL Server details.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=mssql+pyodbc://USERNAME:PASSWORD@SERVER:1433/B3?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
SQL_ECHO=false
FRONTEND_ORIGIN=http://localhost:5173
EMPLOYEE_PURCHASE_REQUESTS_ENABLED=false
LOW_STOCK_THRESHOLD=10
