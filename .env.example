# Copy this file to .env and replace the placeholders.
ENVIRONMENT=development

# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Dummy SQL Server connection - replace when the real database is connected.
# For quick local testing without SQL Server you can use: sqlite:///./dev.db
DATABASE_URL=mssql+pyodbc://dummy_user:dummy_password@localhost:1433/B3A-S7-T2?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# One origin, or several separated by commas.
FRONTEND_ORIGIN=http://localhost:5173

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Let plain employees raise purchase requests too (spec: "if enabled")
EMPLOYEE_PURCHASE_REQUESTS_ENABLED=false
