# Copy to .env and fill in local values. Never commit .env.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# SQL authentication example (URL-encode special characters and driver spaces).
DATABASE_URL=mssql+pyodbc://username:password@localhost:1433/B3A-S7-T2?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# For Windows integrated authentication, use: mssql+pyodbc://@SERVER/DATABASE?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
SQL_ECHO=false
FRONTEND_ORIGIN=http://localhost:5173
EMPLOYEE_PURCHASE_REQUESTS_ENABLED=false
