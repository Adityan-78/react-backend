# Copy this file to ".env" and change the values if needed.

# Address of the FastAPI backend (must end with /api/v1)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# true  = use the built-in demo backend (no server needed, sample data)
# false = talk to the real FastAPI backend above
VITE_DEMO_MODE=false
